{
	"name": "@twin.org/ui-tailwind",
	"version": "0.0.3-next.6",
	"description": "UI package for tailwind",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/twinfoundation/ui.git",
		"directory": "packages/ui-tailwind"
	},
	"author": "martyn.janes@iota.org",
	"license": "Apache-2.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"clean": "rimraf dist coverage",
		"build": "tsc",
		"dev": "nodemon --watch src --ext ts --exec \"npm run build && npm run bundle:esm\"",
		"test": "vitest --config ./vitest.config.ts --no-cache",
		"test:run": "vitest run --config ./vitest.config.ts --no-cache",
		"test:build": "tsc -p ./tests/tsconfig.json --noEmit",
		"test:coverage": "vitest run --coverage --config ./vitest.config.ts --no-cache",
		"bundle:esm": "rollup --config rollup.config.mjs --environment MODULE:esm",
		"bundle:cjs": "rollup --config rollup.config.mjs --environment MODULE:cjs",
		"bundle": "npm run bundle:esm && npm run bundle:cjs",
		"docs:clean": "rimraf docs/reference",
		"docs:generate": "typedoc --options typedoc.config.mjs",
		"docs": "npm run docs:clean && npm run docs:generate",
		"dist": "npm run clean && npm run build && npm run test:build && npm run test:run && npm run bundle",
		"dist:no-test": "npm run clean && npm run build && npm run bundle"
	},
	"dependencies": {
		"@twin.org/core": "next"
	},
	"devDependencies": {
		"@rollup/plugin-json": "6.1.0",
		"@twin.org/nameof-vitest-plugin": "next",
		"autoprefixer": "10.4.27",
		"postcss": "8.5.8",
		"rimraf": "6.1.3",
		"rollup": "4.59.0",
		"rollup-plugin-copy": "3.5.0",
		"tailwindcss": "3.4.17",
		"typedoc": "0.28.17",
		"typedoc-plugin-markdown": "4.10.0",
		"typescript": "5.9.3",
		"vitest": "4.0.18"
	},
	"optionalDependencies": {
		"@rollup/rollup-linux-x64-gnu": "4.59.0"
	},
	"resolutions": {
		"rollup": "4.40.0"
	},
	"exports": {
		".": {
			"types": "./dist/types/index.d.ts",
			"require": "./dist/cjs/index.cjs",
			"import": "./dist/esm/index.mjs"
		},
		"./css/*.css": "./dist/css/*.css"
	},
	"files": [
		"dist",
		"docs",
		"locales"
	],
	"keywords": [
		"twin",
		"trade",
		"iota",
		"framework",
		"blockchain",
		"ui",
		"components",
		"react",
		"frontend"
	],
	"bugs": {
		"url": "git+https://github.com/twinfoundation/ui/issues"
	},
	"homepage": "https://twindev.org"
}
